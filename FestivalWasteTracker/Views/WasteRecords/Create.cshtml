@model FestivalWasteTracker.Models.WasteRecord

@{
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
    ViewData["Title"] = "Report Waste";
}

<div class="container mt-4">
    <div class="card shadow-lg p-4">

        <h3 class="text-success mb-4">♻ Report Waste</h3>

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label>Festival</label>
                <select asp-for="EventName" class="form-control" required>
                    <option value="">-- Select Festival --</option>
                    <option>Ganesh Chaturthi</option>
                    <option>Diwali</option>
                    <option>Navratri</option>
                    <option>Holi</option>
                    <option>Durga Puja</option>
                    <option>Eid</option>
                    <option>Christmas</option>
                    <option>Local Fair</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Waste Type</label>
                <select asp-for="WasteType" class="form-control">
                    <option>Plastic</option>
                    <option>Organic</option>
                    <option>Paper</option>
                    <option>Mixed</option>
                </select>
            </div>

            <div class="mb-3">
                <label>Quantity (kg)</label>
                <input asp-for="QuantityKg" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Reported By</label>
                <input asp-for="ReportedBy" class="form-control" required />
            </div>

            <!-- ⭐ DATE SECTION (Mam instruction) -->
            <div class="mb-3">
                <label class="form-label">Collection Date</label>
                <input asp-for="CollectedDate" type="date" class="form-control" required />
            </div>

            <!-- LOCATION SEARCH -->
            <div class="mb-3 position-relative">
                <label>Search Location</label>
                <input id="searchBox" class="form-control" placeholder="Search area / street / building" autocomplete="off" />
                <div id="suggestions" class="list-group"></div>

                <input type="hidden" asp-for="LocationName" id="locationText" />
                <input type="hidden" asp-for="Latitude" id="lat" />
                <input type="hidden" asp-for="Longitude" id="lng" />
            </div>

            <button type="button" class="btn btn-outline-success mb-3" onclick="useLocation()">📍 Use Current Location</button>

            <div id="map" style="height:350px;border-radius:10px;"></div>

            <div class="mt-3">
                <label>Upload Image</label>
                <input type="file" name="ImageFile" class="form-control" />
            </div>

            <button type="submit" class="btn btn-success w-100 mt-4">Submit Report</button>

        </form>

    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

    var map = L.map('map').setView([19.155,73.265], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        attribution:'© OpenStreetMap'
    }).addTo(map);

    var marker;

    function useLocation(){
    navigator.geolocation.getCurrentPosition(function(pos){

    var lat = pos.coords.latitude;
    var lng = pos.coords.longitude;

    map.setView([lat,lng],16);

    if(marker) map.removeLayer(marker);
    marker = L.marker([lat,lng]).addTo(map);

    document.getElementById("lat").value = lat;
    document.getElementById("lng").value = lng;
    document.getElementById("locationText").value = "Current Location";

    });
    }

    document.getElementById("searchBox").addEventListener("keyup",function(){

    let query=this.value;
    if(query.length<3) return;

    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${query}`)
    .then(res=>res.json())
    .then(data=>{

    let box=document.getElementById("suggestions");
    box.innerHTML="";

    data.slice(0,5).forEach(place=>{

    let item=document.createElement("a");
    item.className="list-group-item list-group-item-action";
    item.innerText=place.display_name;

    item.onclick=function(){

    let lat=place.lat;
    let lng=place.lon;

    map.setView([lat,lng],16);

    if(marker) map.removeLayer(marker);
    marker=L.marker([lat,lng]).addTo(map);

    document.getElementById("locationText").value=place.display_name;
    document.getElementById("lat").value=lat;
    document.getElementById("lng").value=lng;

    box.innerHTML="";
    document.getElementById("searchBox").value=place.display_name;
    }

    box.appendChild(item);

    });
    });
    });
</script>