@{
    ViewData["Title"] = "Verify OTP";
}

<h2>Enter OTP</h2>
<form method="post" asp-action="VerifyOtp">
    <label>OTP:</label><br />
    <input type="text" name="otp" required /><br /><br />
    <button type="submit">Verify OTP</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}
