@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Login - Festival Waste Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

        body {
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(rgba(0,150,120,0.75), rgba(0,150,120,0.85)), url('/images/recycle.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            font-family: Segoe UI;
        }

        .login-card {
            width: 400px;
            padding: 40px;
            border-radius: 20px;
            background: rgba(255,255,255,0.18);
            backdrop-filter: blur(18px);
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
            text-align: center;
        }

        .form-control {
            margin-bottom: 15px;
            height: 45px;
        }

        .btn-login {
            width: 100%;
            height: 45px;
            background: #2e7d32;
            border: none;
            font-weight: 600;
        }

        .create-link {
            margin-top: 15px;
        }

            .create-link a {
                color: white;
                text-decoration: none;
                font-weight: 600;
            }

    </style>
</head>

<body>

    <div class="login-card">

        <h3 class="mb-4 text-success">Login</h3>

        <form method="post" action="/Account/Login">

            <input type="email" name="email" class="form-control" placeholder="Email" required />

            <input type="password" name="password" class="form-control" placeholder="Password" required />

            <button class="btn btn-success btn-login">Login</button>

        </form>

        <div class="create-link">
            <a href="/Login/Register">Create Account</a>
        </div>

    </div>

</body>
</html>