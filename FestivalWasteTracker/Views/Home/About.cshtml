@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}


<!DOCTYPE html>
<html>
<head>
    <title>About Festival Waste</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

        body {
            margin: 0;
            padding: 0;
            font-family: Segoe UI;
            overflow-x: hidden;
        }

        /* ⭐ NAVBAR */
        .topbar {
            background: white;
            padding: 15px 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .menu a {
            margin-left: 35px;
            text-decoration: none;
            color: #333;
            font-weight: 500;
        }

            .menu a:hover {
                color: #198754;
            }

        /* ⭐ BANNER */
        .banner {
            height: 300px;
            background: linear-gradient(rgba(0,0,0,.6),rgba(0,0,0,.6)), url('https://images.unsplash.com/photo-1604187351574-c75ca79f5807');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            padding-left: 80px;
            color: white;
        }

        /* ⭐ MAIN SECTION */
        .about-section {
            padding: 80px;
            display: flex;
            gap: 60px;
            align-items: center;
        }

            .about-section img {
                width: 550px;
                border-radius: 12px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            }

        /* ⭐ GREEN FEATURES */
        .green-section {
            background: #0d3f2b;
            color: white;
            padding: 80px;
            display: flex;
            gap: 40px;
        }

        .feature-card {
            background: #198754;
            padding: 30px;
            border-radius: 12px;
            flex: 1;
        }

        /* ⭐ SERVICE */
        .service {
            text-align: center;
            padding: 70px;
            background: #f5f5f5;
        }

        /* ⭐ FOOTER */
        .footer {
            background: #0b2e21;
            color: white;
            padding: 60px;
            display: flex;
            justify-content: space-between;
        }

    </style>

</head>
<body>


    <!-- ⭐ NAVBAR -->
    



    <!-- ⭐ BANNER -->
    <div class="banner">
        <div>
            <h1 class="fw-bold">About Festival Waste Tracker</h1>
            <p>Smart waste monitoring system for cleaner festival celebrations</p>
        </div>
    </div>



    <!-- ⭐ ABOUT CONTENT -->
    <div class="about-section">

        <div>
            <h2 class="text-success fw-bold">Trusted Waste Management Platform</h2>

            <p class="mt-3">
                Festival Waste Tracker helps authorities and volunteers monitor waste generated
                during festivals like Ganesh Utsav, Diwali and Holi.
            </p>

            <ul>
                <li>✔ Real Time Waste Tracking</li>
                <li>✔ Live Map Monitoring</li>
                <li>✔ Festival Wise Analytics</li>
                <li>✔ Eco Friendly Initiative</li>
            </ul>
        </div>

        <img src="/images/about.jpg" class="card-img-top">

    </div>



    <!-- ⭐ GREEN SECTION -->
    <div class="green-section">

        <div class="feature-card">
            <h4>Our Mission</h4>
            <p>
                To create cleaner festival environments by enabling digital waste reporting and
                faster resolution through smart tracking technology.
            </p>
        </div>

        <div class="feature-card">
            <h4>Our Vision</h4>
            <p>
                To build sustainable cities where waste generated during public events is
                efficiently managed and recycled.
            </p>
        </div>

        <div class="feature-card">
            <h4>Community Impact</h4>
            <p>
                Encouraging citizen participation in maintaining hygiene and cleanliness
                during large celebrations.
            </p>
        </div>

    </div>



    <!-- ⭐ SERVICE SECTION -->
    <div class="service">

        <h3 class="fw-bold text-success">We Provide Smart Waste Reporting Service</h3>

        <p class="mt-3">
            Citizens can upload waste images with location and authorities can monitor reports
            on dashboard for quick cleanup action.
        </p>

        <button class="btn btn-success px-4 mt-3">Get Started</button>

    </div>



    <!-- ⭐ FOOTER -->
   


</body>
</html>