@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Create Account</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

        body {
            height: 100vh;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Segoe UI;
            /* ✅ SAME BACKGROUND AS LOGIN */
            background: linear-gradient(rgba(20,90,50,0.75), rgba(20,90,50,0.85)), url('/images/eco.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

        .register-card {
            width: 420px;
            padding: 40px;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(18px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            text-align: center;
        }

        .title {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 25px;
            color: #1b5e20;
        }

        .form-control {
            margin-bottom: 15px;
            border-radius: 10px;
        }

        .btn-register {
            width: 100%;
            padding: 10px;
            font-weight: 600;
            background: #2e7d32;
            border: none;
            border-radius: 10px;
        }

            .btn-register:hover {
                background: #1b5e20;
            }

        .login-link {
            margin-top: 15px;
            display: block;
            color: white;
            font-weight: 500;
            text-decoration: none;
        }

    </style>

</head>

<body>

    <div class="register-card">

        <div class="title">Create Account</div>

        <form method="post" action="/Account/Register">

            <input type="text" name="email" class="form-control" placeholder="Email" required />

            <input type="password" name="password" class="form-control" placeholder="Password" required />

            <button class="btn btn-success btn-register">Register</button>

        </form>

        <a href="/Account/Login" class="login-link">Already have account? Login</a>

    </div>

</body>
</html>