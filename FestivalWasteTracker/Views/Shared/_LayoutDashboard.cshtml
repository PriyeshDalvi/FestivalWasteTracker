@using Microsoft.AspNetCore.Http
@{
    var user = Context.Session.GetString("User");
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html>
<head>
    <title>Festival Waste Tracker</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: Segoe UI;
            background: #f4f6f9;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            position: fixed;
            background: linear-gradient(180deg,#0f5132,#198754);
            color: white;
            padding-top: 20px;
        }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 30px;
            }

            .sidebar a {
                display: block;
                color: white;
                padding: 12px 20px;
                text-decoration: none;
                font-size: 16px;
            }

                .sidebar a:hover {
                    background: rgba(255,255,255,0.15);
                }

        .content {
            margin-left: 240px;
            padding: 20px;
        }

        .topbar {
            background: white;
            padding: 12px 20px;
            border-bottom: 1px solid #ddd;
            margin-left: 240px;
        }
    </style>

</head>

<body>

    @if (role != null)
    {
        <div class="sidebar">

            <h4><i class="fa fa-leaf"></i> Festival Waste</h4>

            <a href="/Dashboard">
                <i class="fa fa-chart-line"></i> Dashboard
            </a>

            @if (role == "viewer")
            {
                <a href="/WasteRecords/Create">
                    <i class="fa fa-plus"></i> Report Waste
                </a>
            }

            @if (role == "admin")
            {
                <a href="/WasteRecords">
                    <i class="fa fa-folder"></i> Waste Records
                </a>
            }

            <a href="/Login/Logout">
                <i class="fa fa-sign-out-alt"></i> Logout
            </a>

        </div>

        <div class="topbar">
            Welcome @(role == "admin" ? "Admin" : "User") 👋
        </div>
    }

    <div class="content">
        @RenderBody()
    </div>

</body>
</html>